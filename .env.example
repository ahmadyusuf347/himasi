# Salin menjadi .env untuk uji lokal. Di Vercel isi lewat Settings > Environment Variables.
# JANGAN pernah meng-commit file .env ke GitHub.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi_dengan_service_role_key
