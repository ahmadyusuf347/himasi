<%- include('partials/top',{title:'Kontak'}) %>
<main class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[1fr_1.4fr]">
  <div data-reveal><h2 class="font-head text-4xl font-bold uppercase">Hubungi Kami</h2>
    <p class="mt-3 text-slate-600">Kirim pertanyaan, saran, atau ajakan kolaborasi. Pesan Anda diterima langsung oleh pengurus HIMA SI.</p>
    <ul class="mt-6 space-y-3"><li><i class="bi bi-geo-alt mr-3 text-brand"></i><%= s.address %></li><li><i class="bi bi-telephone mr-3 text-brand"></i><%= s.phone %></li><li><i class="bi bi-envelope mr-3 text-brand"></i><%= s.email %></li></ul></div>
  <form method="post" action="/kontak" class="card space-y-4 p-6 md:p-8" data-reveal>
    <% if(sent==='1'){ %><p class="rounded-lg bg-green-100 p-3 text-sm text-green-800">Pesan terkirim. Terima kasih!</p><% } else if(sent==='0'){ %><p class="rounded-lg bg-red-100 p-3 text-sm text-red-800">Nama, email, dan pesan wajib diisi.</p><% } %>
    <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off">
    <div class="grid gap-4 sm:grid-cols-2"><div><label class="mb-1 block text-sm">Nama</label><input name="name" required class="input"></div><div><label class="mb-1 block text-sm">Email</label><input type="email" name="email" required class="input"></div></div>
    <div><label class="mb-1 block text-sm">Subjek</label><input name="subject" class="input"></div>
    <div><label class="mb-1 block text-sm">Pesan</label><textarea name="message" rows="5" required class="input"></textarea></div>
    <button class="btn-solid">Kirim Pesan <i class="bi bi-send"></i></button></form>
</main>
<%- include('partials/bottom') %>
