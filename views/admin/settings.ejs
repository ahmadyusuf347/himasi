<%- include('_top') %>
<h1 class="mb-6 font-head text-3xl font-bold">Pengaturan Situs</h1>
<% if(saved){ %><p class="mb-4 rounded-lg bg-green-100 p-3 text-sm text-green-800">Pengaturan disimpan.</p><% } %>
<form method="post" enctype="multipart/form-data" class="max-w-3xl space-y-6"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% SETTINGS.forEach(([g,items])=>{ %><fieldset class="space-y-4 rounded-xl bg-white p-6 shadow-sm"><legend class="float-left mb-2 w-full font-head text-xl font-bold"><%= g %></legend>
<% items.forEach(([k,l,t,opt])=>{ %><div class="clear-both"><label class="mb-1 block text-sm font-medium"><%= l %></label>
<% if(t==='textarea'){ %><textarea name="<%= k %>" rows="4" class="input"><%= S[k]||'' %></textarea>
<% } else if(t==='image'){ %><% if(S[k]){ %><img src="<%= S[k] %>" class="mb-2 max-h-28 rounded bg-slate-200 object-contain" alt=""><label class="mb-2 flex cursor-pointer items-center gap-2 text-sm text-red-700"><input type="checkbox" name="remove_<%= k %>"> Hapus gambar ini</label><% } %><input type="file" name="<%= k %>" accept="image/*" class="text-sm" <%= ['logo','favicon','filosofi_image'].includes(k)?'':'data-shrink' %>><p data-size class="mt-1 text-xs text-brand"></p>
<% } else if(t==='file'){ %><% if(S[k]){ %><a href="<%= S[k] %>" target="_blank" rel="noopener noreferrer" class="mb-1 block text-sm text-brand underline"><i class="bi bi-paperclip"></i> File saat ini</a><label class="mb-2 flex cursor-pointer items-center gap-2 text-sm text-red-700"><input type="checkbox" name="remove_<%= k %>"> Hapus file ini</label><% } %><input type="file" name="<%= k %>" class="text-sm"><p class="text-xs text-slate-500">PNG / SVG / PDF / ZIP. Kosongkan jika tidak diganti.</p>
<% } else if(t==='select'){ %><select name="<%= k %>" class="input"><% opt.forEach(o=>{ %><option value="<%= o[0] %>" <%= (S[k]||opt[0][0])===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select>
<% } else if(t==='bool'){ %><label class="inline-flex cursor-pointer items-center gap-2 text-sm"><input type="checkbox" name="<%= k %>" <%= S[k]==='on'?'checked':'' %> class="h-5 w-5"> Aktif</label>
<% } else if(t==='color'){ %><input type="color" name="<%= k %>" value="<%= S[k] %>" class="h-10 w-20 cursor-pointer rounded">
<% } else { %><input name="<%= k %>" value="<%= S[k]||'' %>" class="input"><% } %></div><% }) %></fieldset><% }) %>
<button class="btn-solid sticky bottom-4">Simpan Semua Pengaturan</button></form>
<%- include('_bottom') %>
