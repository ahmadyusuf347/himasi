<%- include('_top') %><h1 class="mb-6 font-head text-3xl font-bold">Pesan Masuk</h1>
<% if(!msgs.length){ %><p class="text-slate-500">Belum ada pesan.</p><% } %>
<div class="space-y-3"><% msgs.forEach(m=>{ %><div class="rounded-xl bg-white p-5 shadow-sm <%= m.is_read?'':'border-l-4 border-brand' %>">
<div class="flex flex-wrap items-center justify-between gap-2"><p class="font-semibold"><%= m.name %> <a class="text-sm font-normal text-brand" href="mailto:<%= m.email %>"><%= m.email %></a></p><span class="text-xs text-slate-500"><%= new Date(m.created_at).toLocaleString('id-ID') %></span></div>
<% if(m.subject){ %><p class="mt-1 text-sm font-medium"><%= m.subject %></p><% } %><p class="mt-2 whitespace-pre-line text-sm"><%= m.message %></p>
<div class="mt-3 flex gap-2"><% if(!m.is_read){ %><form method="post" action="/admin/messages/<%= m.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="rounded-lg bg-slate-100 px-3 py-1.5 text-sm">Tandai dibaca</button></form><% } %>
<form method="post" action="/admin/messages/<%= m.id %>/delete" data-confirm="Hapus pesan?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="rounded-lg bg-red-100 px-3 py-1.5 text-sm text-red-700">Hapus</button></form></div></div><% }) %></div>
<%- include('_bottom') %>
