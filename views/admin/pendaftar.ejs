<%- include('_top') %>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3"><h1 class="font-head text-3xl font-bold">Data Pendaftar <span class="text-lg text-slate-500">(<%= rows.length %>)</span></h1>
  <% if(rows.length){ %><div class="flex flex-wrap gap-2"><a href="/admin/pendaftar/export.xlsx" class="btn-solid"><i class="bi bi-file-earmark-excel"></i> Unduh Excel (.xlsx)</a><a href="/admin/pendaftar/export.csv" class="inline-flex items-center gap-2 rounded-lg bg-slate-200 px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-slate-300"><i class="bi bi-filetype-csv"></i> CSV</a>
  <form method="post" action="/admin/pendaftar/clear" data-confirm="Hapus SEMUA data pendaftar? Pastikan sudah diunduh. Tindakan ini tidak bisa dibatalkan."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="inline-flex items-center gap-2 rounded-lg border-2 border-red-300 px-4 py-2 text-sm font-semibold text-red-700 transition-colors hover:bg-red-50"><i class="bi bi-trash"></i> Hapus Semua</button></form></div><% } %></div>
<% if(!rows.length){ %><p class="text-slate-500">Belum ada pendaftar.</p><% } else { %>
<div class="overflow-x-auto rounded-xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3">Waktu</th><% cols.forEach(c=>{ %><th class="p-3"><%= c %></th><% }) %><th class="p-3 text-right">Aksi</th></tr></thead><tbody>
<% rows.forEach(x=>{ %><tr class="border-t align-top"><td class="whitespace-nowrap p-3 text-slate-500"><%= new Date(x.created_at.includes("T")?x.created_at:x.created_at.replace(" ","T")+"Z").toLocaleString("id-ID") %></td>
<% cols.forEach(c=>{ const it=x.items.find(i=>i.label===c); %><td class="p-3"><% if(it&&it.file){ %><a href="/admin/pendaftar/file/<%= it.file %>?as=<%= encodeURIComponent(it.value) %>" class="inline-flex items-center gap-1 text-brand underline"><i class="bi bi-paperclip"></i><%= it.value %></a><% } else { %><%= it?it.value:'-' %><% } %></td><% }) %>
<td class="p-3 text-right"><form method="post" action="/admin/pendaftar/<%= x.id %>/delete" data-confirm="Hapus data pendaftar ini?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="rounded-lg bg-red-100 px-3 py-1.5 text-red-700">Hapus</button></form></td></tr><% }) %>
</tbody></table></div><p class="mt-3 text-xs text-slate-500">Tip: setelah satu periode pendaftaran selesai, unduh Excel lalu klik <b>Hapus Semua</b> untuk memulai pendaftaran berikutnya dengan data bersih. Data berisi informasi pribadi (NIM, nomor HP). Jaga kerahasiaannya dan hapus bila sudah tidak diperlukan.</p><% } %>
<%- include('_bottom') %>
