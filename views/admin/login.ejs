<%
let seed=7; const rnd=()=>{seed=(seed*16807)%2147483647;return seed/2147483647;};
const pts=Array.from({length:46},()=>[rnd()*600,rnd()*1000,rnd()]);
const lines=[]; pts.forEach((a,i)=>{ pts.map((b,j)=>[j,Math.hypot(a[0]-b[0],a[1]-b[1])]).filter(x=>x[0]>i).sort((x,y)=>x[1]-y[1]).slice(0,2).forEach(x=>lines.push([a,pts[x[0]]])); });
%>
<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login CMS</title>
<% if(s.favicon){ %><link rel="icon" href="<%= s.favicon %>"><% } %>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
<link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet"><link href="/css/app.css" rel="stylesheet">
<% const rgb=h=>[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)).join(' '); %>
<style>:root{--brand:<%= rgb(s.color_primary) %>;--dark:<%= rgb(s.color_dark) %>;--foot:33 33 33;--accent:<%= rgb(s.color_accent) %>}</style></head>
<body class="min-h-screen bg-white font-body md:grid md:grid-cols-2">
<div class="relative hidden min-h-screen items-center justify-center overflow-hidden bg-[#050d16] md:flex">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <% lines.forEach(l=>{ %><line x1="<%= l[0][0].toFixed(0) %>" y1="<%= l[0][1].toFixed(0) %>" x2="<%= l[1][0].toFixed(0) %>" y2="<%= l[1][1].toFixed(0) %>" stroke="#5fb4d9" stroke-opacity=".35"/><% }) %>
    <% pts.forEach(p=>{ %><circle cx="<%= p[0].toFixed(0) %>" cy="<%= p[1].toFixed(0) %>" r="<%= (2+p[2]*3).toFixed(1) %>" fill="#fff" fill-opacity=".85"/><circle cx="<%= p[0].toFixed(0) %>" cy="<%= p[1].toFixed(0) %>" r="<%= (8+p[2]*14).toFixed(0) %>" fill="#2a9ccf" fill-opacity=".12"/><% }) %>
  </svg>
  <div class="relative flex items-center gap-4 text-white"><% if(s.logo){ %><img src="<%= s.logo %>" class="h-20" alt=""><% } else { %><i class="bi bi-infinity text-7xl text-blue-500"></i><span class="text-5xl font-extrabold tracking-tight"><%= s.site_name %></span><% } %></div>
</div>
<div class="flex min-h-screen flex-col items-center justify-center p-8">
  <form method="post" action="/admin/login" class="w-full max-w-md">
    <h1 class="text-4xl font-bold">Login</h1><p class="mb-10 mt-1 text-sm">Welcome! Silahkan login untuk management website</p>
    <% if(err){ %><p class="mb-4 rounded-lg bg-red-100 p-3 text-sm text-red-700" role="alert"><%= err %></p><% } %>
    <label class="text-sm">User Name</label><input name="username" required autofocus autocomplete="username" maxlength="100" class="mb-3 mt-1 block h-14 w-full rounded-lg border border-brand bg-[#e6e6e6] px-4 outline-none focus:ring-2 focus:ring-brand">
    <label class="text-sm">Password</label><input type="password" name="password" required autocomplete="current-password" maxlength="200" class="mt-1 block h-14 w-full rounded-lg border border-brand bg-[#e6e6e6] px-4 outline-none focus:ring-2 focus:ring-brand">
    <button class="mt-16 h-14 w-full rounded-lg border border-brand bg-[#e6e6e6] text-lg font-bold tracking-wide transition hover:bg-brand hover:text-white">LOGIN</button>
  </form>
  <p class="mt-24 text-center text-sm"><%= s.footer_copyright %></p>
</div></body></html>
