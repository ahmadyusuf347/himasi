<%- include('_top') %>
<div class="mb-6 flex flex-wrap items-center justify-between gap-3"><h1 class="font-head text-3xl font-bold">Struktur Organisasi</h1><a href="/about/struktur" target="_blank" rel="noopener noreferrer" class="text-sm text-brand underline"><i class="bi bi-box-arrow-up-right"></i> Lihat halaman</a></div>
<% if(saved){ %><p class="mb-4 rounded-lg bg-green-100 p-3 text-sm text-green-800" role="status">Struktur disimpan.</p><% } %>
<form method="post" enctype="multipart/form-data" action="/admin/struktur" class="max-w-3xl space-y-5 rounded-xl bg-white p-6 shadow-sm"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <div><label class="mb-1 block text-sm font-medium">Gambar Struktur Organisasi</label>
    <% if(S.struktur_image){ %><div class="mb-3 rounded-lg border bg-slate-50 p-2"><img src="<%= S.struktur_image %>" alt="Gambar struktur saat ini" class="mx-auto max-h-72 w-auto max-w-full object-contain"></div>
    <label class="mb-3 inline-flex cursor-pointer items-center gap-2 text-sm text-red-700"><input type="checkbox" name="remove_image"> Hapus gambar saat ini</label><br><% } %>
    <input type="file" name="struktur_image" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,.jpg,.jpeg,.png,.webp,.avif,.gif" data-shrink class="text-sm"><p data-size class="mt-1 text-xs text-brand"></p>
    <p class="text-xs text-slate-500">Format: JPG, PNG, WebP, AVIF, GIF. Gambar ditampilkan utuh (tidak terpotong) mengikuti lebar halaman. Gunakan lebar minimal 1600 px agar teks terbaca; foto besar diperkecil otomatis di browser. Kosongkan jika tidak diganti.</p></div>
  <div><label class="mb-1 block text-sm font-medium">Teks di bawah judul halaman</label><input name="struktur_subtitle" value="<%= S.struktur_subtitle||'' %>" class="input"></div>
  <div><label class="mb-1 block text-sm font-medium">Deskripsi gambar (untuk pembaca layar &amp; jika gambar gagal dimuat)</label><input name="struktur_alt" value="<%= S.struktur_alt||'' %>" class="input" placeholder="Contoh: Bagan struktur organisasi HIMA SI periode 2026/2027"></div>
  <button class="btn-solid">Simpan</button></form>
<%- include('_bottom') %>
