<%
const nav=[['dash','/admin','bi-speedometer2','Dashboard'],['slider','/admin/slider','bi-collection-play','Slider Home'],['berita','/admin/berita','bi-newspaper','Berita'],['proker','/admin/proker','bi-calendar-check','Proker'],['galery','/admin/galery','bi-images','Galery'],['struktur','/admin/struktur','bi-diagram-3','Struktur'],['formulir','/admin/formulir','bi-ui-checks','Form Pendaftaran'],['pendaftar','/admin/pendaftar','bi-people','Data Pendaftar'],['messages','/admin/messages','bi-envelope','Pesan Masuk'],['settings','/admin/settings','bi-gear','Pengaturan Situs']];
const menu=()=>nav.map(n=>`<a href="${n[1]}" class="dl flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm ${active===n[0]?'bg-brand text-white':'text-white/75 hover:bg-white/10'}"><i class="bi ${n[2]}"></i>${n[3]}</a>`).join('');
const rgb=h=>[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)).join(' ');
const E=escapeFn;
const brand=s.logo?`<img src="${E(s.logo)}" alt="${E(s.site_name)}" class="h-9 w-auto">`:`<i class="bi bi-infinity text-3xl text-blue-400"></i><span class="font-head text-2xl font-bold text-white">${E(s.site_name)}</span>`;
%>
<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CMS <%= s.site_name %></title>
<% if(s.favicon){ %><link rel="icon" href="<%= s.favicon %>"><% } %>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet"><link href="/css/app.css" rel="stylesheet">
<style>:root{--brand:<%= rgb(s.color_primary) %>;--dark:<%= rgb(s.color_dark) %>;--foot:<%= rgb(s.color_footer) %>;--accent:<%= rgb(s.color_accent) %>}</style></head>
<body class="min-h-screen bg-slate-100 font-body text-slate-800 md:flex">
<aside class="fixed inset-y-0 left-0 z-20 hidden w-64 flex-col gap-1 overflow-y-auto bg-foot p-4 md:flex"><a href="/admin" class="mb-6 flex items-center gap-2 px-2 py-2"><%- brand %></a><%- menu() %></aside>
<div id="overlay" class="fixed inset-0 z-40 hidden bg-black/60 opacity-0"></div>
<aside id="drawer" style="transform:translateX(100%)" class="fixed right-0 top-0 z-50 flex h-full w-72 max-w-[85%] flex-col gap-1 overflow-y-auto bg-foot p-4 md:hidden"><button id="menuClose" class="mb-3 self-end text-3xl text-white" aria-label="Tutup"><i class="bi bi-x-lg"></i></button><%- menu() %>
  <a href="/" target="_blank" rel="noopener noreferrer" class="dl mt-4 flex items-center gap-3 border-t border-white/15 px-4 py-2.5 pt-4 text-sm text-white/75"><i class="bi bi-box-arrow-up-right"></i>Lihat Website</a><form method="post" action="/admin/logout" class="dl"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="flex w-full items-center gap-3 px-4 py-2.5 text-sm text-red-300"><i class="bi bi-box-arrow-left"></i>Logout</button></form></aside>
<div class="min-w-0 flex-1 md:ml-64">
  <header class="sticky top-0 z-30 flex items-center justify-between bg-foot px-5 py-3 text-white shadow-sm md:bg-white md:text-slate-700">
    <a href="/admin" class="flex items-center gap-2 md:hidden"><%- brand %></a><span class="hidden text-sm text-slate-500 md:block">Dashboard CMS</span>
    <div class="flex items-center gap-2"><a href="/" target="_blank" rel="noopener noreferrer" class="hidden items-center gap-2 rounded-full border-2 border-transparent px-4 py-1.5 text-sm transition-colors hover:border-brand hover:text-brand md:inline-flex"><i class="bi bi-box-arrow-up-right"></i>Lihat Website</a><form method="post" action="/admin/logout" class="hidden md:block"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="inline-flex items-center gap-2 rounded-full border-2 border-transparent px-4 py-1.5 text-sm transition-colors hover:border-red-500 hover:text-red-600"><i class="bi bi-box-arrow-left"></i>Logout</button></form>
    <button id="menuBtn" class="text-3xl md:hidden" aria-label="Menu"><i class="bi bi-list"></i></button></div></header>
  <main class="p-5 md:p-8">
