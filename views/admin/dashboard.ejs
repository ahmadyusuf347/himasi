<%- include('_top') %><div class="mb-6 flex items-center gap-5 rounded-2xl bg-foot p-6 text-white"><% if(s.logo){ %><img src="<%= s.logo %>" alt="" class="h-14 w-auto"><% } else { %><i class="bi bi-infinity text-5xl text-blue-400"></i><% } %><div><h1 class="font-head text-3xl font-bold">Dashboard <%= s.site_name %></h1><p class="text-sm text-white/70">Kelola seluruh konten website dari sini.</p></div></div>
<div class="grid grid-cols-2 gap-4 lg:grid-cols-5"><% Object.entries(stats).forEach(([k,v])=>{ %><div class="rounded-xl bg-white p-5 shadow-sm"><p class="text-3xl font-bold text-brand"><%= v %></p><p class="text-sm text-slate-500"><%= k %></p></div><% }) %></div>
<p class="mt-8 text-sm text-slate-600">Gunakan menu di samping untuk mengelola berita, proker, galery, struktur organisasi, pesan masuk, serta logo, favicon, warna, dan teks website di <a class="text-brand underline" href="/admin/settings">Pengaturan Situs</a>.</p>
<%- include('_bottom') %>
