<%- include('partials/top',{title:'Struktur'}) %>
<%
const e=escapeFn;
const person=(m,cw)=>`<div class="max-w-full overflow-hidden rounded-lg text-center shadow-sm" style="width:${cw||16}rem"><div class="bg-brand px-3 py-1.5 text-xs font-semibold uppercase leading-snug text-white">${e(m.role||'')}</div><div class="bg-[#e6e6e6] px-3 py-4">${m.photo?`<img src="${e(m.photo)}" alt="" loading="lazy" class="mx-auto mb-2 h-16 w-16 rounded-full object-cover">`:''}<p class="text-sm font-medium text-brand">${e(m.name)}</p>${m.nim?`<p class="mt-0.5 text-xs text-slate-700">NIM : ${e(m.nim)}</p>`:''}</div></div>`;
const mx=Math.max(bphL.length,bphR.length), cw=mx<=2?16:mx===3?12.5:10; // kartu BPH menyempit bila anggotanya banyak agar muat
const side=(list,left)=>`<div class="relative flex items-start gap-6 pt-8 ${left?'mr-8':'ml-8'} max-xl:mx-0 max-xl:mt-4 max-xl:flex-col max-xl:items-center max-xl:gap-4 max-xl:pt-0"><span class="absolute top-0 border-t border-brand max-xl:hidden" style="${left?`left:${cw/2}rem;right:-2rem`:`left:-2rem;right:${cw/2}rem`}"></span>${list.map(m=>`<div class="relative"><span class="absolute -top-8 left-1/2 h-8 border-l border-brand max-xl:hidden"></span>${person(m,cw)}</div>`).join('')}</div>`;
%>
<main class="mx-auto max-w-7xl px-5">
  <p class="mb-12 text-center text-xl md:text-2xl"><%= s.struktur_subtitle %></p>
  <% if(!chain.length && !bphL.length && !bphR.length && !divs.length){ %><p class="rounded-2xl border border-dashed border-slate-300 p-10 text-center text-slate-500">Struktur organisasi belum diisi. Isi melalui Dashboard CMS &rarr; Struktur.</p><% } %>
  <div class="flex flex-col items-center" data-reveal>
    <% chain.forEach((m,i)=>{ %><% if(i){ %><div class="h-8 border-l border-brand"></div><% } %><%- person(m) %><% }) %>
    <% if(chain.length && divs.length && !bphL.length && !bphR.length){ %><div class="h-8 border-l border-brand"></div><% } %>
  </div>
  <% if(bphL.length||bphR.length){ %>
  <div class="flex max-xl:block" data-reveal>
    <div class="flex flex-1 justify-end max-xl:justify-center"><%- bphL.length?side(bphL,true):'' %></div>
    <div class="flex flex-1 justify-start border-l border-brand max-xl:justify-center max-xl:border-l-0"><%- bphR.length?side(bphR,false):'' %></div>
  </div>
  <% if(divs.length){ %><div class="mx-auto h-8 w-0 border-l border-brand max-xl:hidden"></div><% } %>
  <% } %>
  <% if(divs.length){ %>
  <div class="relative max-xl:mt-8" style="--n:<%= divs.length %>">
    <div class="absolute top-0 border-t border-brand max-lg:hidden" style="left:calc(50% / var(--n));right:calc(50% / var(--n))"></div>
    <div class="grid gap-6 [grid-template-columns:repeat(var(--n),minmax(0,1fr))] max-lg:grid-cols-2 max-sm:grid-cols-1">
      <% divs.forEach(d=>{ %>
      <div class="relative pt-8 max-lg:pt-0" data-reveal><span class="absolute left-1/2 top-0 h-8 border-l border-brand max-lg:hidden"></span>
        <div class="mx-auto min-h-[10rem] w-full max-w-[17rem] overflow-hidden rounded-lg bg-[#e6e6e6] text-center shadow-sm">
          <h3 class="bg-brand px-3 py-1.5 text-xs font-semibold uppercase leading-snug text-white"><%= d.name %></h3>
          <div class="px-3 py-4 text-sm">
            <% d.heads.forEach(h=>{ %><p class="text-brand"><%= (h.role||'KETUA').toUpperCase() %></p><p class="mb-3"><%= h.name %></p><% }) %>
            <% if(d.members.length){ %><p class="text-brand">ANGGOTA</p><ol class="mt-1 inline-block text-left text-xs leading-relaxed"><% d.members.forEach((m,i)=>{ %><li><%= i+1 %>.&nbsp; <%= m.name %></li><% }) %></ol><% } %>
          </div>
        </div>
      </div><% }) %>
    </div>
  </div>
  <% } %>
</main>
<%- include('partials/bottom') %>
