<%- include('partials/top',{title:'Struktur'}) %>
<%
const e=escapeFn;
const photo=m=>`<div class="z-10 h-24 w-24 shrink-0 overflow-hidden rounded-full border-[6px] border-brand bg-slate-300 md:h-28 md:w-28">${m.photo?`<img src="${e(m.photo)}" class="h-full w-full object-cover" alt="">`:'<div class="flex h-full items-center justify-center text-5xl text-slate-500"><i class="bi bi-person-fill"></i></div>'}</div>`;
const card=(role,list)=>`<div class="flex w-full max-w-md items-center"><div class="flex flex-col gap-1">${list.map(photo).join('')}</div><div class="-ml-10 min-h-[6rem] flex-1 self-stretch rounded-r-2xl border-t-[10px] border-brand bg-[#f2f2f2] py-4 pl-14 pr-4"><p class="font-semibold uppercase text-brand">${e(role||'')}</p>${list.length>1?list.map(m=>`<p class="text-sm">- ${e(m.name)}</p>`).join(''):`<p class="text-sm md:text-base">${e(list[0].name)}</p>`}</div></div>`;
const L=bph.filter((x,i)=>i%2===0), Rr=bph.filter((x,i)=>i%2===1);
%>
<main class="mx-auto max-w-7xl px-5">
  <p class="mb-12 text-center text-xl md:text-2xl">Struktur Organisasi HIMA SI Institut Citra Buana Indonesia</p>
  <% if(!chain.length && !bph.length && !divs.length){ %><p class="text-center text-slate-500">Struktur belum diisi di Dashboard CMS.</p><% } %>
  <div class="flex flex-col items-center" data-reveal>
    <% chain.forEach((m,i)=>{ %><% if(i){ %><div class="h-10 w-1.5 bg-black"></div><% } %><%- card(m.role,[m]) %><% }) %>
    <% if(chain.length && divs.length && !bph.length){ %><div class="h-10 w-1.5 bg-black"></div><% } %>
  </div>
  <% if(bph.length){ %>
  <div class="mt-6 flex flex-col items-center gap-6 md:mt-0 md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-0 md:py-0" data-reveal>
    <div class="flex w-full flex-col items-center gap-6 md:items-end"><% L.forEach(x=>{ %><div class="flex w-full items-center justify-center md:justify-end"><%- card(x.role,x.list) %><div class="hidden h-1.5 w-10 bg-black md:block"></div></div><% }) %></div>
    <div class="hidden w-1.5 self-stretch bg-black md:block" style="min-height:11rem"></div>
    <div class="flex w-full flex-col items-center gap-6 md:items-start"><% Rr.forEach(x=>{ %><div class="flex w-full items-center justify-center md:justify-start"><div class="hidden h-1.5 w-10 bg-black md:block"></div><%- card(x.role,x.list) %></div><% }) %></div>
  </div>
  <% } %>
  <% if(divs.length){ %>
  <div class="relative mt-8 md:mt-0" style="--n:<%= divs.length %>">
    <div class="absolute top-0 hidden h-1.5 bg-black lg:block" style="left:calc(50% / var(--n));right:calc(50% / var(--n))"></div>
    <div class="grid gap-5 sm:grid-cols-2 lg:[grid-template-columns:repeat(var(--n),minmax(0,1fr))]">
      <% divs.forEach(d=>{ const k=d.list.filter(x=>/kadiv/i.test(x.role)), a=d.list.filter(x=>!/kadiv/i.test(x.role)); %>
      <div data-reveal><div class="mx-auto hidden h-10 w-1.5 bg-black lg:block"></div>
        <div class="min-h-[16rem] overflow-hidden rounded-2xl bg-[#f2f2f2] text-center">
          <h3 class="bg-brand px-3 py-2 text-lg font-semibold uppercase leading-tight text-white"><%= d.name %></h3>
          <div class="p-4 text-lg"><% k.forEach(m=>{ %><p class="font-semibold text-brand">KADIV</p><p><%= m.name %></p><% }) %>
            <% if(a.length){ %><p class="mt-4 font-semibold text-brand">ANGGOTA</p><% a.forEach(m=>{ %><p><%= m.name %></p><% }) %><% } %></div></div></div><% }) %>
    </div>
  </div>
  <% } %>
</main>
<%- include('partials/bottom') %>
