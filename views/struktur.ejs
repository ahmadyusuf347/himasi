<%- include('partials/top',{title:'Struktur'}) %>
<main class="mx-auto max-w-7xl px-5">
  <p class="mb-8 text-center text-xl md:text-2xl"><%= s.struktur_subtitle %></p>
  <% if(s.struktur_image){ %>
  <a href="#" data-photos="<%= JSON.stringify([s.struktur_image]) %>" data-title="<%= s.struktur_alt||'' %>" class="block cursor-zoom-in rounded-2xl border border-slate-300 bg-white p-2 shadow-sm md:p-4" data-reveal>
    <img src="<%= s.struktur_image %>" alt="<%= s.struktur_alt||'Bagan struktur organisasi' %>" class="mx-auto block h-auto w-full max-w-full object-contain"></a>
  <p class="mt-3 text-center text-xs text-slate-500">Klik gambar untuk memperbesar</p>
  <% } else { %><p class="rounded-2xl border border-dashed border-slate-300 p-10 text-center text-slate-500">Bagan struktur organisasi belum diunggah. Unggah melalui Dashboard CMS &rarr; Struktur.</p><% } %>
</main>
<%- include('partials/lightbox') %>
<%- include('partials/bottom') %>
