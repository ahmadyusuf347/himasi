<%- include('partials/top',{title:'Program Kerja '+s.periode}) %>
<%
const cats=['Akademik','Minat & bakat','Sosial','Pengembangan Organisasi'], sts=['Sedang Berjalan','Selesai','Akan Datang'];
const ico={'Akademik':'bi-mortarboard-fill','Minat & bakat':'bi-controller','Sosial':'bi-people-fill','Pengembangan Organisasi':'bi-diagram-3-fill'};
const on=a=>a?'bg-brand text-white':'hover:bg-slate-100';
const link=o=>'/proker?'+new URLSearchParams(Object.fromEntries(Object.entries(o).filter(x=>x[1]))).toString();
%>
<main class="mx-auto max-w-7xl px-5">
  <p class="mb-10 text-center text-xl md:text-2xl">Agenda & Kegiatan HIMA SI Institut Citra Buana Indonesia</p>
  <div class="grid gap-8 lg:grid-cols-[300px_1fr]">
    <aside class="h-fit rounded-xl border border-slate-400 bg-white p-5 lg:p-6">
      <h2 class="mb-4 ml-3 w-fit font-head text-3xl font-bold uppercase underline decoration-slate-300 underline-offset-4">Filter</h2>
      <a href="/proker" class="block rounded-lg px-3 py-3 text-lg <%= on(!category&&!status) %>">Semua</a>
      <% cats.forEach(c=>{ %><a href="<%= link({category:c,status}) %>" class="block rounded-lg px-3 py-3 text-lg <%= on(category===c) %>"><%= c %></a><% }) %>
      <p class="px-3 py-3 text-lg font-semibold">Status</p>
      <% sts.forEach(x=>{ %><a href="<%= link({category,status:x}) %>" class="block rounded-lg px-3 py-3 text-lg <%= on(status===x) %>"><%= x %><% if(x!=='Akan Datang'){ %> (<%= count(x) %>)<% } %></a><% }) %>
    </aside>
    <div class="grid content-start gap-5 sm:grid-cols-2 xl:grid-cols-3">
      <% if(!items.length){ %><p class="col-span-full text-slate-500">Belum ada program kerja untuk filter ini.</p><% } %>
      <% items.forEach(p=>{ %>
      <article class="flex min-h-[17rem] flex-col rounded-2xl border-2 border-brand bg-[#f2f2f2] p-6" data-reveal>
        <i class="bi <%= ico[p.category]||'bi-calendar2-event' %> text-4xl leading-none"></i>
        <h3 class="mt-4 font-head text-3xl font-bold leading-none"><%= p.title %></h3><p class="mt-1 text-sm font-light"><%= p.divisi %></p>
        <p class="mt-2 text-xs"><i class="bi bi-calendar3 mr-1"></i><%= p.date_text %></p>
        <span class="mt-2 w-fit rounded-full px-4 py-0.5 text-xs <%= p.status==='Selesai'?'bg-[#b4e4f2] text-brand':p.status==='Sedang Berjalan'?'bg-amber-200 text-amber-800':'bg-slate-300 text-slate-700' %>"><%= p.status %></span>
        <details class="mt-auto pt-4"><summary class="ml-auto w-fit cursor-pointer list-none rounded-full border-2 border-brand bg-white px-4 py-1 text-[11px] text-brand">Lihat Detail</summary><p class="mt-3 text-sm"><%= p.description||'Belum ada deskripsi.' %></p></details>
      </article><% }) %>
    </div>
  </div>
</main>
<%- include('partials/bottom') %>
