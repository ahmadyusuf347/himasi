<%- include('partials/top',{title:'About Us'}) %>
<main class="mx-auto max-w-6xl px-5">
  <% [['Profil',s.profil],['Sejarah',s.sejarah]].forEach(x=>{ %>
  <section class="mb-14" data-reveal><h2 class="font-head text-4xl font-bold uppercase"><%= x[0] %></h2><p class="mt-3 whitespace-pre-line text-justify text-base font-light leading-relaxed md:text-xl"><%= x[1] || 'Belum diisi.' %></p></section><% }) %>
  <section class="mt-16 grid gap-8 md:grid-cols-2">
    <% [['VISI','bi-eye',s.visi],['MISI','bi-bullseye',s.misi]].forEach(x=>{ %>
    <div class="hover-lift border border-slate-400 p-7 md:p-9" data-reveal><i class="bi <%= x[1] %> vm-ico text-5xl text-brand"></i><h3 class="mt-3 font-head text-4xl font-bold md:text-5xl"><%= x[0] %></h3><p class="mt-3 whitespace-pre-line text-justify text-base font-light leading-relaxed md:text-lg"><%= x[2] || 'Belum diisi.' %></p></div><% }) %>
  </section>
</main>
<%- include('partials/bottom') %>
