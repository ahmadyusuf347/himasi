<%- include('partials/top',{title:'Galery'}) %>
<main class="mx-auto max-w-7xl px-5"><% if(!items.length){ %><p class="text-center text-slate-500">Belum ada album.</p><% } %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"><% items.forEach(g=>{
    let list=[]; try{ list=JSON.parse(g.photos||'[]'); }catch(e){} if(!list.length && g.image) list=[g.image];
    const cover=g.image||list[0]; %>
    <a href="#" data-photos="<%= JSON.stringify(list) %>" data-title="<%= g.title||'' %>" class="group relative block aspect-square overflow-hidden bg-[#ccc]" data-reveal>
      <% if(cover){ %><img src="<%= cover %>" alt="<%= g.title||'' %>" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105"><% } else { %><i class="bi bi-image-fill absolute inset-0 flex items-center justify-center text-6xl text-black"></i><% } %>
      <span class="absolute right-5 top-5 flex h-8 min-w-8 items-center justify-center gap-1 rounded-lg bg-white/90 px-2 text-brand"><i class="bi bi-stack"></i><% if(list.length>1){ %><span class="text-xs font-semibold"><%= list.length %></span><% } %></span>
      <% if(g.title){ %><div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-white via-white/80 to-transparent px-6 pb-6 pt-14"><p class="text-lg font-semibold leading-snug text-brand"><%= g.title %></p><p class="text-sm text-black"><%= fd(g.date) %></p></div><% } %></a><% }) %></div></main>
<div id="lb" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 [&:not(.hidden)]:flex" role="dialog" aria-modal="true" aria-label="Galeri foto">
  <button data-lb-close class="absolute right-4 top-4 text-3xl text-white" aria-label="Tutup"><i class="bi bi-x-lg"></i></button>
  <button data-lb-prev class="absolute left-3 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-2xl text-white transition hover:bg-brand md:left-8" aria-label="Sebelumnya"><i class="bi bi-chevron-left"></i></button>
  <div data-lb-stage class="flex h-full w-full flex-col items-center justify-center px-16 py-14"><img data-lb-img src="" alt="" class="max-h-full max-w-full object-contain"><p data-lb-title class="mt-3 text-center text-white"></p></div>
  <button data-lb-next class="absolute right-3 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-2xl text-white transition hover:bg-brand md:right-8" aria-label="Berikutnya"><i class="bi bi-chevron-right"></i></button>
  <span data-lb-count class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-white/15 px-4 py-1 text-sm text-white"></span>
</div>
<%- include('partials/bottom') %>
